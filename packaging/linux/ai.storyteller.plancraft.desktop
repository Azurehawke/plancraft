[Desktop Entry]
Type=Application
Name=PlanCraft
GenericName=Spreadsheet
Comment=Calculate, analyse and chart data in workbooks
Exec=plancraft %F
TryExec=plancraft
Icon=ai.storyteller.plancraft
Terminal=false
StartupNotify=true
StartupWMClass=ai.storyteller.plancraft
Categories=Office;Spreadsheet;
MimeType=application/vnd.openxmlformats-officedocument.spreadsheetml.sheet;application/vnd.ms-excel.sheet.macroEnabled.12;application/vnd.ms-excel.sheet.binary.macroEnabled.12;application/vnd.oasis.opendocument.spreadsheet;text/csv;text/tab-separated-values;
Keywords=spreadsheet;workbook;sheet;table;formula;chart;pivot;xlsx;xlsb;ods;csv;tsv;excel;
